// app.rc - icon, manifest, version information and the Settings dialog.
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_APP ICON "app.ico"

1 RT_MANIFEST "app.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 320, 262
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "What to keep", -1, 7, 7, 306, 96
    LTEXT           "Text is always kept. Also keep:", -1, 16, 21, 290, 10
    AUTOCHECKBOX    "Pictures (screenshots, images copied from programs and web pages)", IDC_IMAGES, 16, 34, 290, 10, WS_TABSTOP
    AUTOCHECKBOX    "Copied files (the list of their names and folders)", IDC_FILES, 16, 48, 290, 10, WS_TABSTOP
    LTEXT           "Delete unpinned items after", -1, 16, 65, 92, 10
    EDITTEXT        IDC_DELETE_DAYS, 110, 63, 30, 13, ES_NUMBER | WS_TABSTOP
    LTEXT           "days   (0: keep everything forever)", -1, 144, 65, 160, 10
    LTEXT           "", IDC_FOLDER, 16, 84, 222, 10, SS_PATHELLIPSIS | SS_NOPREFIX
    PUSHBUTTON      "Open folder", IDC_OPEN_FOLDER, 244, 81, 60, 14, WS_TABSTOP
    GROUPBOX        "Shortcut", -1, 7, 108, 306, 50
    LTEXT           "Open the history with:", -1, 16, 124, 80, 10
    COMBOBOX        IDC_HOTKEY, 100, 122, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Enter or a double-click pastes into the program you were using", IDC_PASTE_ENTER, 16, 140, 290, 10, WS_TABSTOP
    GROUPBOX        "General", -1, 7, 163, 306, 72
    LTEXT           "Theme:", -1, 16, 179, 80, 10
    COMBOBOX        IDC_THEME, 100, 177, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Start with Windows", IDC_AUTOSTART, 16, 197, 120, 10, WS_TABSTOP
    AUTOCHECKBOX    "...in the tray, without the window", IDC_STARTTRAY, 140, 197, 165, 10, WS_TABSTOP
    AUTOCHECKBOX    "Closing the window keeps it recording in the tray", IDC_CLOSETRAY, 16, 214, 290, 10, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 208, 241, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 263, 241, 50, 15
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Akshaya Simha"
            VALUE "FileDescription", "Clipboard Manager"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ClipboardManager"
            VALUE "LegalCopyright", "\251 2026 Akshaya Simha"
            VALUE "OriginalFilename", "ClipboardManager.exe"
            VALUE "ProductName", "Clipboard Manager"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
