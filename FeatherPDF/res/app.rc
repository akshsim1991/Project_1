// app.rc - icon, manifest, version information and dialogs.
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_APP ICON "app.ico"

1 RT_MANIFEST "app.manifest"

IDD_PASSWORD DIALOGEX 0, 0, 260, 90
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password required"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PASSWORD_TEXT, 10, 10, 240, 24
    EDITTEXT        IDC_PASSWORD_EDIT, 10, 40, 240, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Open", IDOK, 146, 66, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 66, 50, 15
END

IDD_EXTRACT DIALOGEX 0, 0, 260, 104
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Extract pages"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_EXTRACT_TEXT, 10, 10, 240, 18
    EDITTEXT        IDC_EXTRACT_RANGE, 10, 32, 240, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Save each page as a separate file", IDC_EXTRACT_SEPARATE, 10, 54, 240, 12, WS_TABSTOP
    DEFPUSHBUTTON   "Save...", IDOK, 146, 80, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 80, 50, 15
END

IDD_OCR DIALOGEX 0, 0, 280, 172
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Recognise text (OCR)"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Finds the words on scanned pages and adds them as invisible text, so you can search, select and copy them. The pages look exactly the same.", -1, 10, 8, 260, 26
    GROUPBOX        "Pages", -1, 10, 38, 260, 48
    AUTORADIOBUTTON "&All pages", IDC_PAGES_ALL, 18, 50, 70, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "C&urrent page", IDC_PAGES_CURRENT, 94, 50, 80, 12
    AUTORADIOBUTTON "Pa&ges:", IDC_PAGES_RANGE, 18, 66, 44, 12
    EDITTEXT        IDC_PAGES_EDIT, 64, 65, 198, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    AUTOCHECKBOX    "&Skip pages that already have text", IDC_OCR_SKIP, 10, 94, 260, 12, WS_TABSTOP
    LTEXT           "Uses the text recognition built into Windows, in the languages of your Windows profile. Nothing leaves this PC. Undo (Ctrl+Z) takes it back.", -1, 10, 112, 260, 26
    DEFPUSHBUTTON   "Recognise", IDOK, 162, 150, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 218, 150, 52, 15
END

IDD_WATERMARK DIALOGEX 0, 0, 280, 190
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Watermark"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Text:", -1, 10, 12, 50, 10
    EDITTEXT        IDC_WM_TEXT, 64, 10, 206, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "&Colour:", -1, 10, 32, 50, 10
    COMBOBOX        IDC_WM_COLOR, 64, 30, 70, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Opacity:", -1, 146, 32, 50, 10
    COMBOBOX        IDC_WM_OPACITY, 200, 30, 70, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Si&ze:", -1, 10, 52, 50, 10
    COMBOBOX        IDC_WM_SIZE, 64, 50, 70, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Direction:", -1, 146, 52, 50, 10
    COMBOBOX        IDC_WM_LAYOUT, 200, 50, 70, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Put it &behind the page content (hidden by pictures and scans)", IDC_WM_BEHIND, 10, 70, 260, 12, WS_TABSTOP
    GROUPBOX        "Pages", -1, 10, 88, 260, 48
    AUTORADIOBUTTON "&All pages", IDC_PAGES_ALL, 18, 100, 70, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "C&urrent page", IDC_PAGES_CURRENT, 94, 100, 80, 12
    AUTORADIOBUTTON "Pa&ges:", IDC_PAGES_RANGE, 18, 116, 44, 12
    EDITTEXT        IDC_PAGES_EDIT, 64, 115, 198, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "Undo (Ctrl+Z) removes the watermark again.", -1, 10, 144, 260, 12
    DEFPUSHBUTTON   "Add", IDOK, 162, 168, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 218, 168, 52, 15
END

IDD_PAGENUMBERS DIALOGEX 0, 0, 280, 156
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Page numbers"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Format:", -1, 10, 12, 50, 10
    COMBOBOX        IDC_PN_FORMAT, 64, 10, 90, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Position:", -1, 164, 12, 40, 10
    COMBOBOX        IDC_PN_POSITION, 206, 10, 64, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Start at:", -1, 10, 32, 50, 10
    EDITTEXT        IDC_PN_START, 64, 30, 40, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "Si&ze:", -1, 164, 32, 40, 10
    COMBOBOX        IDC_PN_SIZE, 206, 30, 64, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Pages", -1, 10, 52, 260, 48
    AUTORADIOBUTTON "&All pages", IDC_PAGES_ALL, 18, 64, 70, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "C&urrent page", IDC_PAGES_CURRENT, 94, 64, 80, 12
    AUTORADIOBUTTON "Pa&ges:", IDC_PAGES_RANGE, 18, 80, 44, 12
    EDITTEXT        IDC_PAGES_EDIT, 64, 79, 198, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "The first page chosen gets the start number. Undo (Ctrl+Z) removes the numbers again.", -1, 10, 106, 260, 20
    DEFPUSHBUTTON   "Add", IDOK, 162, 134, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 218, 134, 52, 15
END

IDD_EXPORT DIALOGEX 0, 0, 280, 150
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Export"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Format:", -1, 10, 12, 50, 10
    COMBOBOX        IDC_EXPORT_FORMAT, 64, 10, 206, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Resolution:", IDC_EXPORT_DPI_LABEL, 10, 32, 50, 10
    COMBOBOX        IDC_EXPORT_DPI, 64, 30, 206, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Pages", -1, 10, 50, 260, 48
    AUTORADIOBUTTON "&All pages", IDC_PAGES_ALL, 18, 62, 70, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "C&urrent page", IDC_PAGES_CURRENT, 94, 62, 80, 12
    AUTORADIOBUTTON "Pa&ges:", IDC_PAGES_RANGE, 18, 78, 44, 12
    EDITTEXT        IDC_PAGES_EDIT, 64, 77, 198, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "", IDC_EXPORT_NOTE, 10, 104, 260, 20
    DEFPUSHBUTTON   "Export...", IDOK, 162, 128, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 218, 128, 52, 15
END

IDD_COMMENT DIALOGEX 0, 0, 280, 156
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Comment"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_COMMENT_INFO, 10, 8, 260, 10, SS_ENDELLIPSIS | SS_NOPREFIX
    EDITTEXT        IDC_COMMENT_EDIT, 10, 22, 260, 104, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Delete", IDC_COMMENT_DELETE, 10, 134, 56, 15, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 160, 134, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 218, 134, 52, 15
END

IDD_REPLACE DIALOGEX 0, 0, 280, 124
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find and replace text"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Find:", -1, 10, 12, 56, 10
    EDITTEXT        IDC_REPLACE_FIND, 70, 10, 200, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Replace &with:", -1, 10, 32, 56, 10
    EDITTEXT        IDC_REPLACE_WITH, 70, 30, 200, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Match &case", IDC_REPLACE_CASE, 70, 50, 120, 12, WS_TABSTOP
    LTEXT           "Every place in the document is changed. Changed text keeps its font when that font has all the letters; otherwise a similar font is used. Undo (Ctrl+Z) takes it back.", -1, 10, 68, 260, 28
    DEFPUSHBUTTON   "Replace all", IDOK, 160, 102, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 218, 102, 52, 15
END

IDD_COMMENTS DIALOGEX 0, 0, 380, 220
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Comments"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_COMMENTS_INFO, 10, 8, 360, 10
    CONTROL         "", IDC_COMMENTS_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 22, 360, 168
    PUSHBUTTON      "&Go to", IDC_COMMENTS_GOTO, 10, 198, 52, 15, WS_TABSTOP
    PUSHBUTTON      "&Edit...", IDC_COMMENTS_EDIT, 66, 198, 52, 15, WS_TABSTOP
    PUSHBUTTON      "&Delete", IDC_COMMENTS_DELETE, 122, 198, 52, 15, WS_TABSTOP
    DEFPUSHBUTTON   "Close", IDCANCEL, 318, 198, 52, 15
END

IDD_SIGNATURE DIALOGEX 0, 0, 320, 196
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Signature"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Draw your signature in the box, type your name, or use a picture of it.", -1, 10, 8, 300, 10
    CONTROL         "", IDC_SIG_PAD, "FeatherSignPad", WS_BORDER | WS_TABSTOP, 10, 22, 300, 100
    EDITTEXT        IDC_SIG_TYPE, 10, 128, 190, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Picture...", IDC_SIG_PICTURE, 206, 127, 50, 15, WS_TABSTOP
    PUSHBUTTON      "&Clear", IDC_SIG_CLEAR, 260, 127, 50, 15, WS_TABSTOP
    LTEXT           "Ink:", -1, 10, 152, 18, 10
    AUTORADIOBUTTON "&Black", IDC_SIG_BLACK, 30, 151, 40, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Bl&ue", IDC_SIG_BLUE, 72, 151, 40, 10
    AUTOCHECKBOX    "&Remember this signature on this PC", IDC_SIG_REMEMBER, 130, 151, 180, 10, WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 204, 174, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 260, 174, 50, 15
END

IDD_INPUT DIALOGEX 0, 0, 260, 74
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Feather PDF"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_INPUT_LABEL, 10, 8, 240, 18
    EDITTEXT        IDC_INPUT_EDIT, 10, 28, 240, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 146, 52, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 52, 50, 15
END

IDD_ABOUT DIALOGEX 0, 0, 300, 208
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Feather PDF"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APP, IDC_ABOUT_ICON, 12, 10, 21, 20
    LTEXT           "", IDC_ABOUT_NAME, 44, 10, 246, 14, SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_VERSION, 44, 26, 246, 10, SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_TEXT, 12, 44, 278, 136, SS_NOPREFIX
    PUSHBUTTON      "Third-Party &Licenses and Attributions", IDC_ABOUT_LICENSES, 12, 186, 150, 15, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 240, 186, 50, 15
END

IDD_LICENSES DIALOGEX 0, 0, 360, 240
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Third-Party Licenses and Attributions"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_LICENSES_TEXT, 10, 10, 340, 200, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Close", IDCANCEL, 300, 218, 50, 15
END

IDR_NOTICES RCDATA "../THIRD_PARTY_NOTICES.md"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,2,0,0
 PRODUCTVERSION 2,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Akshaya Simha"
            VALUE "FileDescription", "Feather PDF - lightweight PDF viewer and editor"
            VALUE "LegalCopyright", "\251 2026 Akshaya Simha"
            VALUE "FileVersion", "2.2.0.0"
            VALUE "InternalName", "FeatherPDF"
            VALUE "OriginalFilename", "FeatherPDF.exe"
            VALUE "ProductName", "Feather PDF"
            VALUE "ProductVersion", "2.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
