// app.rc - icon, manifest, version information and the password dialog.
#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"

1 RT_MANIFEST "app.manifest"

IDD_PASSWORD DIALOGEX 0, 0, 260, 90
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password required"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PASSWORD_TEXT, 10, 10, 240, 24
    EDITTEXT        IDC_PASSWORD_EDIT, 10, 40, 240, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Open", IDOK, 146, 66, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 66, 50, 15
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Akshaya Simha"
            VALUE "FileDescription", "Feather PDF - lightweight PDF viewer"
            VALUE "LegalCopyright", "\251 2026 Akshaya Simha"
            VALUE "FileVersion", "1.2.0.0"
            VALUE "InternalName", "FeatherPDF"
            VALUE "OriginalFilename", "FeatherPDF.exe"
            VALUE "ProductName", "Feather PDF"
            VALUE "ProductVersion", "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
