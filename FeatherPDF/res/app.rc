    EDITTEXT        IDC_PROP_TITLE, 62, 134, 228, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "&Author:", -1, 10, 154, 50, 10
    EDITTEXT        IDC_PROP_AUTHOR, 62, 152, 228, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "&Subject:", -1, 10, 172, 50, 10
    EDITTEXT        IDC_PROP_SUBJECT, 62, 170, 228, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "&Keywords:", -1, 10, 190, 50, 10
    EDITTEXT        IDC_PROP_KEYWORDS, 62, 188, 228, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PROP_NOTE, 10, 208, 280, 18
    DEFPUSHBUTTON   "OK", IDOK, 182, 230, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 238, 230, 52, 15
END

IDD_PRINT DIALOGEX 0, 0, 540, 318
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Print"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Printer:", -1, 10, 10, 210, 10
    COMBOBOX        IDC_PR_PRINTER, 10, 22, 152, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "P&roperties...", IDC_PR_PROPS, 166, 21, 56, 15
    LTEXT           "", IDC_PR_PAPER, 10, 40, 212, 10
    GROUPBOX        "Pages", -1, 10, 54, 212, 48
    AUTORADIOBUTTON "&All pages", IDC_PAGES_ALL, 18, 66, 76, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "C&urrent page", IDC_PAGES_CURRENT, 98, 66, 90, 12
    AUTORADIOBUTTON "Pa&ges:", IDC_PAGES_RANGE, 18, 82, 44, 12
    EDITTEXT        IDC_PAGES_EDIT, 64, 81, 150, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "&Copies:", -1, 10, 112, 48, 10
    EDITTEXT        IDC_PR_COPIES, 62, 110, 36, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "", IDC_PR_COPIES_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 98, 110, 10, 14
    AUTOCHECKBOX    "C&ollate (whole sets)", IDC_PR_COLLATE, 112, 111, 110, 12, WS_TABSTOP
    LTEXT           "&Layout:", -1, 10, 134, 48, 10
    COMBOBOX        IDC_PR_LAYOUT, 62, 132, 160, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Size:", -1, 10, 154, 48, 10
    COMBOBOX        IDC_PR_SCALE, 62, 152, 160, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Orientation:", -1, 10, 174, 50, 10
    COMBOBOX        IDC_PR_ORIENT, 62, 172, 160, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PR_NOTE, 10, 194, 212, 92
    CONTROL         "", IDC_PR_PREVIEW, "Static", SS_OWNERDRAW | SS_NOTIFY, 232, 10, 298, 270
    PUSHBUTTON      "<", IDC_PR_PREV, 316, 284, 22, 14
    CTEXT           "", IDC_PR_SHEET, 342, 286, 106, 10
    PUSHBUTTON      ">", IDC_PR_NEXT, 452, 284, 22, 14
    DEFPUSHBUTTON   "Print", IDOK, 422, 300, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 478, 300, 52, 14
END

IDD_COMMENT DIALOGEX 0, 0, 280, 156
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Comment"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_COMMENT_INFO, 10, 8, 260, 10, SS_ENDELLIPSIS | SS_NOPREFIX
    EDITTEXT        IDC_COMMENT_EDIT, 10, 22, 260, 104, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Delete", IDC_COMMENT_DELETE, 10, 134, 56, 15, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 160, 134, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 218, 134, 52, 15
END

IDD_REPLACE DIALOGEX 0, 0, 280, 124
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find and replace text"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Find:", -1, 10, 12, 56, 10
    EDITTEXT        IDC_REPLACE_FIND, 70, 10, 200, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Replace &with:", -1, 10, 32, 56, 10
    EDITTEXT        IDC_REPLACE_WITH, 70, 30, 200, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Match &case", IDC_REPLACE_CASE, 70, 50, 120, 12, WS_TABSTOP
    LTEXT           "Every place in the document is changed. Changed text keeps its font when that font has all the letters; otherwise a similar font is used. Undo (Ctrl+Z) takes it back.", -1, 10, 68, 260, 28
    DEFPUSHBUTTON   "Replace all", IDOK, 160, 102, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 218, 102, 52, 15
END

IDD_COMMENTS DIALOGEX 0, 0, 380, 220
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Comments"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_COMMENTS_INFO, 10, 8, 360, 10
    CONTROL         "", IDC_COMMENTS_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 22, 360, 168
    PUSHBUTTON      "&Go to", IDC_COMMENTS_GOTO, 10, 198, 52, 15, WS_TABSTOP
    PUSHBUTTON      "&Edit...", IDC_COMMENTS_EDIT, 66, 198, 52, 15, WS_TABSTOP
    PUSHBUTTON      "&Delete", IDC_COMMENTS_DELETE, 122, 198, 52, 15, WS_TABSTOP
