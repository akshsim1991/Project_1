    LTEXT           "Fra&me:", -1, 10, 168, 40, 10
    COMBOBOX        IDC_TE_FRAME, 56, 166, 110, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 214, 186, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 270, 186, 50, 14
