    AUTOCHECKBOX    "Print line &weights", IDC_PL_LW, 52, 100, 118, 12
    AUTOCHECKBOX    "&Fit to the printer's paper", IDC_PL_FIT, 52, 114, 118, 12
    LTEXT           "", IDC_PL_INFO, 10, 134, 160, 30
    PUSHBUTTON      "&Print...", IDC_PL_PRINT, 10, 226, 76, 16
