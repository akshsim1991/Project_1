IDD_PLOT DIALOGEX 0, 0, 470, 270
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Print"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&What:", -1, 10, 12, 40, 10
    COMBOBOX        IDC_PL_WHAT, 52, 10, 118, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
