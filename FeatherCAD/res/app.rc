    COMBOBOX        1169, 266, 186, 54, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 214, 218, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 270, 218, 50, 14
