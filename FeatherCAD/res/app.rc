    AUTOCHECKBOX    "Also change the dimensions already in the drawing", IDC_DS_APPLY, 10, 136, 230, 12, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 134, 156, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 190, 156, 50, 14
END

IDD_DIMEDIT DIALOGEX 0, 0, 260, 150
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit dimension"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_DE_KIND, 10, 10, 240, 10
