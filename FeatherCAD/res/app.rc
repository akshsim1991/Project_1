// app.rc - icon, manifest, version information and dialogs.
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_APP ICON "app.ico"

1 RT_MANIFEST "app.manifest"

IDD_UNITS DIALOGEX 0, 0, 240, 116
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Drawing units"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Units:", -1, 10, 12, 60, 10
    COMBOBOX        IDC_UNITS_COMBO, 76, 10, 154, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Precision:", -1, 10, 32, 60, 10
    COMBOBOX        IDC_PRECISION_COMBO, 76, 30, 154, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_UNITS_SAMPLE, 76, 48, 154, 10
    AUTOCHECKBOX    "Use these for &new drawings too", IDC_UNITS_DEFAULT, 10, 66, 220, 12, WS_TABSTOP
    LTEXT           "Changing the units does not scale the drawing: 1 unit stays 1 unit.", -1, 10, 80, 220, 10
    DEFPUSHBUTTON   "OK", IDOK, 124, 96, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 180, 96, 50, 14
END

IDD_DRAFTING DIALOGEX 0, 0, 280, 262
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Drafting settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Grid and snap", -1, 10, 6, 260, 66
    AUTOCHECKBOX    "Show &grid (F7)", IDC_GRID_ON, 18, 20, 100, 12, WS_TABSTOP
    LTEXT           "Spacing:", -1, 140, 21, 40, 10
    EDITTEXT        IDC_GRID_SPACING, 184, 19, 78, 13, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "&Snap to spacing (F9)", IDC_SNAP_ON, 18, 38, 110, 12, WS_TABSTOP
    LTEXT           "Spacing:", -1, 140, 39, 40, 10
    EDITTEXT        IDC_SNAP_SPACING, 184, 37, 78, 13, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "&Ortho: horizontal and vertical only (F8; Shift swaps it while held)", IDC_ORTHO_ON, 18, 56, 248, 12, WS_TABSTOP
    GROUPBOX        "Tracking and input", -1, 10, 76, 260, 66
    AUTOCHECKBOX    "&Polar tracking (F10), every", IDC_POLAR_ON, 18, 90, 120, 12, WS_TABSTOP
    COMBOBOX        IDC_POLAR_ANGLE, 140, 88, 50, 120, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "degrees", -1, 194, 90, 40, 10
    AUTOCHECKBOX    "Object snap trac&king (F11): rest on a snap point to line up with it", IDC_OTRACK_ON, 18, 106, 248, 12, WS_TABSTOP
    AUTOCHECKBOX    "&Dynamic input (F12): prompt, input and sizes at the cursor", IDC_DYN_ON, 18, 122, 248, 12, WS_TABSTOP
    GROUPBOX        "Object snaps", -1, 10, 146, 260, 88
    AUTOCHECKBOX    "Object snaps o&n (F3)", IDC_OSNAP_ON, 18, 160, 120, 12, WS_TABSTOP
    AUTOCHECKBOX    "&Endpoint", IDC_OSNAP_FIRST + 0, 18, 176, 70, 12, WS_TABSTOP
    AUTOCHECKBOX    "&Midpoint", IDC_OSNAP_FIRST + 1, 18, 190, 70, 12, WS_TABSTOP
    AUTOCHECKBOX    "&Centre", IDC_OSNAP_FIRST + 2, 18, 204, 70, 12, WS_TABSTOP
    AUTOCHECKBOX    "&Quadrant", IDC_OSNAP_FIRST + 3, 18, 218, 70, 12, WS_TABSTOP
    AUTOCHECKBOX    "&Intersection", IDC_OSNAP_FIRST + 4, 140, 176, 80, 12, WS_TABSTOP
    AUTOCHECKBOX    "Perpendic&ular", IDC_OSNAP_FIRST + 5, 140, 190, 80, 12, WS_TABSTOP
    AUTOCHECKBOX    "&Tangent", IDC_OSNAP_FIRST + 6, 140, 204, 80, 12, WS_TABSTOP
    AUTOCHECKBOX    "Ne&arest", IDC_OSNAP_FIRST + 7, 140, 218, 80, 12, WS_TABSTOP
    PUSHBUTTON      "Select a&ll", IDC_OSNAP_ALL, 150, 158, 54, 14, WS_TABSTOP
    PUSHBUTTON      "C&lear all", IDC_OSNAP_NONE, 208, 158, 54, 14, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 164, 242, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 220, 242, 50, 14
END

IDD_QSELECT DIALOGEX 0, 0, 260, 172
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Quick select"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Object &type:", -1, 10, 12, 60, 10
    COMBOBOX        IDC_QS_TYPE, 76, 10, 174, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Property:", -1, 10, 30, 60, 10
    COMBOBOX        IDC_QS_PROP, 76, 28, 174, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Operator:", -1, 10, 48, 60, 10
    COMBOBOX        IDC_QS_OP, 76, 46, 174, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Value:", -1, 10, 66, 60, 10
    EDITTEXT        IDC_QS_VALUE, 76, 64, 174, 13, ES_AUTOHSCROLL | WS_TABSTOP
    GROUPBOX        "Matching objects", -1, 10, 84, 240, 58
    AUTORADIOBUTTON "&Replace the current selection", IDC_QS_REPLACE, 18, 96, 220, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Add to the current selection", IDC_QS_ADD, 18, 110, 220, 12
    AUTORADIOBUTTON "Re&move from the current selection", IDC_QS_REMOVE, 18, 124, 220, 12
    DEFPUSHBUTTON   "Select", IDOK, 144, 150, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 150, 50, 14
END

IDD_DIMSTYLE DIALOGEX 0, 0, 250, 176
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dimension style"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Text height:", -1, 10, 12, 130, 10
    EDITTEXT        IDC_DS_TEXT, 160, 10, 80, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "&Arrow size:", -1, 10, 30, 130, 10
    EDITTEXT        IDC_DS_ARROW, 160, 28, 80, 13, ES_AUTOHSCROLL | WS_TABSTOP
