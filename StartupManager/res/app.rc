// app.rc - icon, manifest, version information and dialogs.
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_APP ICON "app.ico"

1 RT_MANIFEST "app.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 300, 180
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Appearance", -1, 7, 7, 286, 56
    LTEXT           "Theme:", -1, 16, 23, 90, 10
    COMBOBOX        IDC_THEME, 112, 21, 170, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Refresh the list every:", -1, 16, 42, 92, 10
    COMBOBOX        IDC_REFRESH, 112, 40, 170, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "List and changes", -1, 7, 68, 286, 84
    AUTOCHECKBOX    "Ask before disabling (deleting always asks)", IDC_CONFIRM, 16, 82, 270, 10, WS_TABSTOP
    AUTOCHECKBOX    "Show Windows' own scheduled tasks", IDC_SHOW_MS, 16, 96, 270, 10, WS_TABSTOP
    AUTOCHECKBOX    "Show ""run once"" entries", IDC_SHOW_ONCE, 16, 110, 270, 10, WS_TABSTOP
    AUTOCHECKBOX    "Always start as administrator", IDC_ELEVATE, 16, 124, 270, 10, WS_TABSTOP
    PUSHBUTTON      "Reset column layout", IDC_RESET_COLUMNS, 16, 158, 100, 14, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 188, 158, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 243, 158, 50, 15
END

IDD_ADD DIALOGEX 0, 0, 300, 176
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add a startup entry"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Name:", -1, 7, 9, 60, 10
    EDITTEXT        IDC_ADD_NAME, 70, 7, 223, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Program:", -1, 7, 27, 60, 10
    EDITTEXT        IDC_ADD_PROGRAM, 70, 25, 170, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_ADD_BROWSE, 243, 24, 50, 14, WS_TABSTOP
    LTEXT           "Arguments:", -1, 7, 45, 60, 10
    EDITTEXT        IDC_ADD_ARGS, 70, 43, 223, 13, ES_AUTOHSCROLL | WS_TABSTOP
    GROUPBOX        "Start it for", -1, 7, 62, 140, 48
    AUTORADIOBUTTON "Only me", IDC_ADD_ME, 14, 76, 125, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "All users (administrator)", IDC_ADD_ALL, 14, 90, 125, 10
    GROUPBOX        "Add it as", -1, 153, 62, 140, 48
    AUTORADIOBUTTON "Registry entry (usual)", IDC_ADD_REG, 160, 76, 125, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Startup folder shortcut", IDC_ADD_LNK, 160, 90, 125, 10
    LTEXT           "The program starts every time you sign in to Windows. You can disable or delete the entry here later.", -1, 7, 118, 286, 20
    DEFPUSHBUTTON   "Add", IDOK, 188, 154, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 243, 154, 50, 15
END

IDD_RESTORE DIALOGEX 0, 0, 380, 250
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Restore deleted entries"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Deleted entries are kept here. Tick the ones to put back:", IDC_RES_INFO, 7, 7, 366, 12
    CONTROL         "", IDC_RES_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 22, 366, 198
    PUSHBUTTON      "Open backup folder", IDC_RES_OPEN, 7, 228, 80, 15, WS_TABSTOP
    DEFPUSHBUTTON   "Restore", IDOK, 269, 228, 50, 15, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 323, 228, 50, 15, WS_TABSTOP
END

IDD_DETAILS DIALOGEX 0, 0, 390, 280
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Details"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_DET_TEXT, 7, 7, 376, 244, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Open file location", IDC_DET_FILE, 7, 258, 72, 15, WS_TABSTOP
    PUSHBUTTON      "Show where it is set", IDC_DET_WHERE, 83, 258, 78, 15, WS_TABSTOP
    PUSHBUTTON      "Check on VirusTotal", IDC_DET_VT, 165, 258, 78, 15, WS_TABSTOP
    PUSHBUTTON      "Search online", IDC_DET_SEARCH, 247, 258, 58, 15, WS_TABSTOP
    PUSHBUTTON      "Copy", IDC_DET_COPY, 309, 258, 34, 15, WS_TABSTOP
    DEFPUSHBUTTON   "Close", IDOK, 347, 258, 36, 15, WS_TABSTOP
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Akshaya Simha"
            VALUE "FileDescription", "Startup Manager"
            VALUE "LegalCopyright", "\251 2026 Akshaya Simha"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "StartupManager"
            VALUE "OriginalFilename", "StartupManager.exe"
            VALUE "ProductName", "Startup Manager"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
