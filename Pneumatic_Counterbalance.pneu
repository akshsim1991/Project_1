        <Property name="Bold" value="True" />
        <Property name="Label" value="" />
      </Element>
      <Element type="TextNote" id="2" x="40" y="140" rotation="0">
        <Property name="Text" value="Turn on Realistic physics.  Hold S2 = RAISE (position b),  hold S1 = LOWER (position a),  release = HOLD (closed centre).&#xA;1V2 counterbalance valve, set 3.2 bar: internal pilot from the cap end, built-in check valve for free flow 1 → 2 when raising." />
